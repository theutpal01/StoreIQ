root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
ktlint_standard = android
disabled_rules = import-ordering,no-wildcard-imports,parameter-list-wrapping

[*.{xml,json,yml,yaml,md,gradle}]
indent_size = 2

[*.{gradle,kts}]
ktlint_standard = android
disabled_rules = import-ordering,no-wildcard-imports

[*.{kt,kts}]
ktlint_standard = android
disabled_rules = import-ordering,no-wildcard-imports,parameter-list-wrapping,no-trailing-whitespace